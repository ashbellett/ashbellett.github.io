#!/usr/bin/env ruby
# Replaces the vendored KaTeX with another release from npm, so the script that
# renders formulae at build time, the stylesheet and the fonts always match.
#
#   bin/update-katex           # latest release
#   bin/update-katex 0.19.0    # a given release
#
# The npm tarball is checked against the registry's integrity hash before
# anything is written.
require "base64"
require "digest"
require "fileutils"
require "json"
require "net/http"
require "rubygems/package"
require "stringio"
require "zlib"

ROOT = File.expand_path("..", __dir__)
SCRIPT = File.join(ROOT, "_vendor/katex/katex.min.js")
STYLESHEET = File.join(ROOT, "assets/css/katex.css")
FONTS = File.join(ROOT, "assets/css/fonts")

def fetch(url, limit = 5)
  response = Net::HTTP.get_response(URI(url))
  case response
  when Net::HTTPSuccess then response.body
  when Net::HTTPRedirection
    abort "Too many redirects fetching #{url}" if limit.zero?
    fetch(response["location"], limit - 1)
  else abort "#{url} returned #{response.code}"
  end
end

def vendored_version
  File.read(SCRIPT)[/version:"([^"]+)"/, 1]
end

release = JSON.parse(fetch("https://registry.npmjs.org/katex/#{ARGV.fetch(0, "latest")}"))
version = release.fetch("version")
algorithm, expected = release.dig("dist", "integrity").split("-", 2)
abort "Unexpected integrity algorithm #{algorithm}" unless algorithm == "sha512"

tarball = fetch(release.dig("dist", "tarball"))
abort "Integrity check failed for katex #{version}" unless Base64.strict_encode64(Digest::SHA512.digest(tarball)) == expected

files = {}
Gem::Package::TarReader.new(Zlib::GzipReader.new(StringIO.new(tarball))) do |tar|
  tar.each { |entry| files[entry.full_name] = entry.read if entry.file? }
end
script = files.fetch("package/dist/katex.min.js")
stylesheet = files.fetch("package/dist/katex.min.css")
fonts = files.select { |name, _| name.match?(%r{\Apackage/dist/fonts/[^/]+\.woff2\z}) }
abort "No woff2 fonts in katex #{version}" if fonts.empty?

previous = vendored_version
File.write(SCRIPT, script)
# Every browser the site supports reads woff2, so drop the woff and ttf copies.
File.write(STYLESHEET, stylesheet.gsub(/,url\([^)]+\) format\("(?:woff|truetype)"\)/, ""))
FileUtils.rm(Dir[File.join(FONTS, "KaTeX_*")])
fonts.each { |name, data| File.binwrite(File.join(FONTS, File.basename(name)), data) }

puts "KaTeX #{previous} -> #{version}. Rebuild the site and check the formulae before committing."
